{
    "name": "header",
    "mode": "dock", // dock = designated space, hide = on top of workspace
    "layer": "top",
    "position": "top",
    "height": 33, // NOTE: sync with left/right corner images
    "reload_style_on_change": true, // for debugging, mostly
    "fixed-center": true,
    // margin and spacing MUST be defined by css
    "margin": "0 0 0 0",
    "spacing": 0,
    "include": "$HOME/.config/waybar/modules.json",

    "modules-left": [
        "hyprland/workspaces",
        "image#right-corner",
    ],

    "modules-center": [
        "image#left-corner",
        "privacy",
        "clock",
        "group/music",
        "image#right-corner"
    ],

    "modules-right": [
        "image#left-corner",
        "group/system-monitor",
        "group/system-utils",
        "bluetooth",
        "network",
        "battery",
        "custom/power",
    ],

    "image#left-corner": {
        "path": "$HOME/.config/waybar/assets/left-corner.png",
        "size": 33,
    },

    "image#right-corner": {
        "path": "$HOME/.config/waybar/assets/right-corner.png",
        "size": 33,
    },
}
